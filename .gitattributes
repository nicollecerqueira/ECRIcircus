# Normaliza fim de linha: tudo em LF no repositório e no working tree.
# Sem isto, o core.autocrlf=true do Windows deixa arquivos em CRLF localmente,
# gerando ruído no Biome (que espera LF) e escondendo erros reais de formatação.
* text=auto eol=lf

# Binários: nunca tratar como texto.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
