# Copy to .env for local dev. Ports match docker-compose.dev.yml (weird ports).
NODE_ENV=development
PORT=3000

# Postgres (dev container maps 55432 -> 5432)
DATABASE_URL=postgres://prato:prato@localhost:55432/prato

# Redis (dev container maps 56379 -> 6379) — Socket.IO adapter, locks, jobs
REDIS_URL=redis://localhost:56379

# Auth (Avenir standard: access 15m / refresh 7d)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS: dev origins of the three web apps
WEB_STAFF_ORIGIN=http://localhost:5173
WEB_KDS_ORIGIN=http://localhost:5174
WEB_ORDER_ORIGIN=http://localhost:5175

# Skeleton phase: serve stub in-memory data instead of requiring Postgres.
# Flip to false once MikroORM entities + migrations are wired (backend phase).
USE_STUB_DATA=true
